{
  "name": "days-gone-achievement-tracker",
  "version": "1.3.8",
  "description": "Read-only Days Gone Steam achievement dashboard with optional save evidence",
  "author": "Phil Forster",
  "homepage": "https://philforster.co.uk",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build:windows": "node tools/build-deployment.js",
    "pack:windows": "electron-builder --win --x64 --dir",
    "check:installer": "node tools/deployment-preflight.js",
    "build:engine": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "uk.co.philforster.daysgoneachievementtracker",
    "productName": "Days Gone Achievement Tracker",
    "copyright": "Copyright \u00a9 2026 Phil Forster",
    "asar": false,
    "compression": "normal",
    "directories": {
      "output": "dist/engine",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "README.md",
      "LOG.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Days Gone Achievement Tracker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Days Gone Achievement Tracker",
      "uninstallDisplayName": "Days Gone Achievement Tracker",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "deployment-engine-${version}.${ext}",
      "include": "build/deployment-engine.nsh",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico"
    },
    "extraFiles": [
      {
        "from": "build/generated/Project Gone Uninstaller.exe",
        "to": "Project Gone Uninstaller.exe"
      }
    ]
  }
}
